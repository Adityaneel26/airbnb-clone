<% layout('layaouts/boilerplate') %>
<div class="row mt-3">
    <div class="col-6 offset-3">
        <h1 class="col-6 offset-3">login for wanderlust</h1>
        <form action="/login" method="post" class="needs-validation" novalidate>
             <div class="mb-3">
                        <label for="username" class="form-label">username</label>
                        <input type="text" name="username" id="username"  placeholder="enter the username" class="form-control" required>
                        <div class="valid-feedback">
                             Looks good!
                        </div>
                        <div class="invalid-feedback">
                            Please Enter a valid username
                            
                        </div>
                    </div>
                  
                          <div class="mb-3">
                        <label for="password" class="form-label">password</label>
                        <input type="password" name="password" id="password"  placeholder="enter the password" class="form-control" required>
                        <div class="valid-feedback">
                             Looks good!
                        </div>
                        <div class="invalid-feedback">
                            Please Enter a valid password
                            .
                        </div>
                    </div>
                    <button class="btn btn-success">login</button>
        </form>
    </div>
</div>